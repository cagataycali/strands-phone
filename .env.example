# Written by infra/up.sh to /etc/strands-phone.env on the host. No AWS secrets: the instance role signs.
VC_HOST=abc123.voiceconnector.chime.aws
CALLER_ID=+15551234567
PUBLIC_IP=203.0.113.10
AWS_REGION=us-east-1
# optional: NOVA_MODEL=amazon.nova-2-sonic-v1:0  VOICE=matthew  MAX_CALL_S=600  LOG=INFO
# PHONE_PERSONA=leaf turns the line into LEAF, a Fauna Sprout robot (strands_phone/leaf.py). default = the plain agent.
# These go in .secrets.env (gitignored); deploy/deploy.sh copies it to the root-only /etc/strands-phone.env.
# PHONE_PERSONA=leaf  LEAF_URL=https://leaf2.cagatay.my  LEAF_PHONE_TOKEN=...  LEAF_PHONE_CONFIRM_CODE=...
